<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add
        name="httpPlatformHandler"
        path="*"
        verb="*"
        modules="httpPlatformHandler"
        resourceType="Unspecified"
        requireAccess="Script" />
    </handlers>
    <httpPlatform
      processPath="C:\Program Files\nodejs\node.exe"
      arguments="backend-server.mjs"
      startupTimeLimit="120"
      processesPerApplication="1"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\stdout"
      requestTimeout="00:10:00">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOST" value="127.0.0.1" />
        <environmentVariable name="UPLOADS_DIR" value="C:\Shravan_Backend\uploads" />
        <environmentVariable name="MONGODB_URI" value="mongodb://127.0.0.1:27017/website-weaver-kit" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
